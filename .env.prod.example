POSTGRES_DB=cinepolis_rc
POSTGRES_USER=cinepolis
POSTGRES_PASSWORD=change_this_password

NODE_ENV=production
PORT=3001
API_VERSION=v1
APP_NAME=Ruta Cinepolis

JWT_SECRET=change_this_secret_with_at_least_32_characters
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_refresh_secret_with_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://YOUR_PUBLIC_IP

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
POS_RATE_LIMIT_MAX=500

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=Ruta Cinepolis <noreply@cinepolis.com.pe>

LOG_LEVEL=info
LOG_DIR=./logs
BCRYPT_ROUNDS=12

POINTS_RATE=0.05
PREMIUM_VISITS_THRESHOLD=10
GOLDEN_VISITS_THRESHOLD=25
