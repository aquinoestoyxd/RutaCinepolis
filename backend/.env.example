# ──────────────────────────────────────────────
# Ruta Cinépolis - Environment Variables
# Copiar este archivo como .env y completar valores
# ──────────────────────────────────────────────

# Aplicación
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME="Ruta Cinépolis"

# Base de datos PostgreSQL
DATABASE_URL="postgresql://cinepolis:cinepolis_secret@localhost:5432/cinepolis_rc"
DB_NAME=cinepolis_rc
DB_USER=cinepolis
DB_PASSWORD=cinepolis_secret
DB_PORT=5432

# JWT
JWT_SECRET=change_this_super_secret_key_min_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS - orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3001,http://localhost:4200

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
POS_RATE_LIMIT_MAX=500

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@cinepolis.com.pe
SMTP_PASS=your_smtp_password
SMTP_FROM="Ruta Cinépolis <noreply@cinepolis.com.pe>"

# AWS (producción)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=cinepolis-rc-assets

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Bcrypt
BCRYPT_ROUNDS=12

# Configuración de negocio (valores por defecto - se sobre-escriben en SystemConfig)
POINTS_RATE=0.05
PREMIUM_VISITS_THRESHOLD=10
GOLDEN_VISITS_THRESHOLD=25
DISCOUNT_TICKET_PREMIUM=0.20
DISCOUNT_CANDY_PREMIUM=0.10
DISCOUNT_TICKET_GOLDEN=0.30
DISCOUNT_CANDY_GOLDEN=0.15
